-- School database: students, courses and enrolments (SQL Server / SSMS, T-SQL)

-- Use a separate database instead of master
IF DB_ID('SchoolDB') IS NULL
    CREATE DATABASE SchoolDB;
GO

USE SchoolDB;
GO

DROP TABLE IF EXISTS enrolments;
DROP TABLE IF EXISTS courses;
DROP TABLE IF EXISTS students;
GO

-- ---------- TABLES ----------

CREATE TABLE students (
    id         INT IDENTITY(1,1) PRIMARY KEY,
    first_name NVARCHAR(100) NOT NULL,
    last_name  NVARCHAR(100) NOT NULL,
    email      NVARCHAR(255) NOT NULL UNIQUE
);

CREATE TABLE courses (
    id      INT IDENTITY(1,1) PRIMARY KEY,
    title   NVARCHAR(150) NOT NULL,
    credits INT NOT NULL DEFAULT 3
);

CREATE TABLE enrolments (
    id          INT IDENTITY(1,1) PRIMARY KEY,
    student_id  INT NOT NULL,
    course_id   INT NOT NULL,
    enrolled_on DATE NOT NULL DEFAULT CAST(GETDATE() AS DATE),
    grade       NVARCHAR(2) NULL,  -- NULL until the course is graded
    FOREIGN KEY (student_id) REFERENCES students(id),
    FOREIGN KEY (course_id)  REFERENCES courses(id),
    UNIQUE (student_id, course_id)  -- same student cannot enrol on the same course twice
);
GO

